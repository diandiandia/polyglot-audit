{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polyglot-audit.internal/schemas/coverage_observation.schema.json",
  "description": "SWR-021 版本化数据契约；绑定 DSR-006/007/034。coverage_observation 记录：worker 报告的行区间覆盖及其来源与置信度。",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "unit_id",
    "dimension",
    "source",
    "ranges",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "dimension": {
      "enum": [
        "inventoried",
        "signal_scanned",
        "context_supplied",
        "observed_read",
        "review_claimed"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "line_start",
          "line_end"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "confidence": {
      "enum": [
        "exact",
        "estimated",
        "unknown"
      ]
    }
  }
}
