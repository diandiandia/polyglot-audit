# Python 运行产物
__pycache__/
*.pyc
*.pyo

# 测试运行产生的记录与报告（可由测试重新生成）
tests/performance/records/
tests/holdout/reports/
tests/model_eval/records/

# 临时与运行产物
.tmp-*
*.log
events.db
.scratch-*/

# 运行侧禁用词清单（SR-016）：目标项目名称不入库。
# 审计目标与诊断工作区一律放在仓库之外；这里只保留通用的临时模式，
# 不携带任何目标派生标识符（RUN-LESSONS 泄漏清查红线）。
tests/model_eval/forbidden_tokens.local.json
poc-task-*
audit-target-*/

# 探针/诊断临时目录（SR-016：目标代码副本不入库）
.hunt-tmp/
.probe-tmp/
.upstream-tmp/
